# Python build and environment files
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local session logs; preserve the directory expected by the GUI launcher
logs/*
!logs/.gitkeep
*.log

# Temporary scenes and videos generated by local runs
config/_*.ttt
*.mp4

# Reproducible planning caches and historical debugging runs
results/normal/diagnostics/
results/normal/*staging/
results/normal/prefix_smoke/
results/normal/fast_reference/
results/normal/rrt_paths/
results/normal/geometry_pair_checks.jsonl

# Reproducible offline recovery runs; reviewed examples live in examples/recovery
results/recovery/

# Local machine configuration and credentials
.env
.env.*
.DS_Store
Thumbs.db
